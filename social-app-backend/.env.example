APP_NAME="Social App API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# The default guard is JWT-based — see config/auth.php.
AUTH_GUARD=api

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=coslagosto25
DB_USERNAME=postgres
DB_PASSWORD=12042002

# Sessions are not used by the stateless JWT API.
SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# JWT authentication — generate with `php artisan jwt:secret`.
JWT_SECRET=
JWT_ALGO=HS256
JWT_TTL=60

# Comma-separated list of origins allowed to issue SPA requests via Sanctum.
# (Not used by the JWT flow, kept for reference if Sanctum is reintroduced.)
# SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Where the frontend lives — used when generating absolute links from the API.
FRONTEND_URL=http://localhost:3000

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
